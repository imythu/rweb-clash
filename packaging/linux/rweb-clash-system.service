[Unit]
Description=R-Clash host proxy service
Documentation=https://github.com/imythu/rweb-clash
After=network.target
Before=rweb-clash-ready.service

[Service]
Type=exec
User=rweb-clash
Group=rweb-clash
Environment=RWEB_CLASH_LISTEN=127.0.0.1:31990
Environment=RWEB_CLASH_ROOT=/var/lib/rweb-clash
Environment=RWEB_CLASH_LOG=info
EnvironmentFile=-/etc/default/rweb-clash
ExecStart=/usr/local/bin/rweb-clash --no-open
ExecStartPost=/usr/local/bin/rweb-clash --wait-api 3600
WorkingDirectory=/var/lib/rweb-clash
StateDirectory=rweb-clash
StateDirectoryMode=0750
Restart=on-failure
RestartSec=3
TimeoutStartSec=3700
TimeoutStopSec=30
KillMode=mixed
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
