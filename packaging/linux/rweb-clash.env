# Optional overrides for /etc/default/rweb-clash.
# RWEB_CLASH_LISTEN=127.0.0.1:31990
# RWEB_CLASH_LOG=info
# The system installer appends a random RWEB_CLASH_API_TOKEN when none exists.
# RWEB_CLASH_API_TOKEN=replace-with-at-least-16-characters
# RWEB_CLASH_ALLOWED_ORIGINS=
# RWEB_CLASH_ALLOW_PRIVATE_SOURCES=0
# RWEB_CLASH_MIHOMO_VALIDATION_TIMEOUT_SECS=120
